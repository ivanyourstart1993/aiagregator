# Caddy reverse proxy — automatic HTTPS (Let's Encrypt) for all app domains.
# Domains are injected from infra/.env.prod (APP_DOMAIN / ADMIN_DOMAIN / API_DOMAIN).
# Point each domain's DNS A-record at the VPS IP before starting Caddy.

{$APP_DOMAIN} {
	encode gzip
	reverse_proxy web:3000
}

{$ADMIN_DOMAIN} {
	encode gzip
	reverse_proxy admin:3001
}

{$API_DOMAIN} {
	encode gzip
	reverse_proxy api:4000
}

# --- Visavo (second product on the same box) -------------------------------
# Uncomment once the Visavo stack is running on this host and exposes its
# backend container as `visavo-backend:PORT` on a shared docker network.
#
# api.visavo.ai {
# 	encode gzip
# 	reverse_proxy visavo-backend:3000
# }
