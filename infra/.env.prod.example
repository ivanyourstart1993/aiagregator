# ---------------------------------------------------------------------------
# Production env for the single-VPS deploy. Copy to infra/.env.prod and fill in.
# NEVER commit .env.prod — only this .example file is tracked.
#
# Generate strong secrets with:  openssl rand -base64 32
# ---------------------------------------------------------------------------

# --- Domains (used by Caddy for auto-HTTPS) ---
APP_DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com

# --- Postgres (internal; not exposed outside docker network) ---
POSTGRES_USER=aiagg
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=aiagg
DATABASE_URL=postgresql://aiagg:CHANGE_ME_strong_password@postgres:5432/aiagg?schema=public

# --- Redis (internal) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_strong_password
REDIS_URL=redis://:CHANGE_ME_strong_password@redis:6379

# --- MinIO / S3 (internal endpoint; bucket auto-created on first boot) ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME_access_key
S3_SECRET_KEY=CHANGE_ME_secret_key
S3_BUCKET=aiagg

# --- Auth ---
AUTH_JWT_SECRET=CHANGE_ME_min_32_bytes
AUTH_JWT_ISSUER=aiagg
AUTH_JWT_AUDIENCE=aiagg
NEXTAUTH_SECRET=CHANGE_ME_min_32_bytes
NEXTAUTH_URL=https://example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# One-time welcome bonus (spendable BONUS balance) granted the first time an
# account verifies its email / signs up via Google. 0 or unset = disabled.
# Read by the api service. Keep in sync with the "$X free credit" blog CTA copy.
WELCOME_BONUS_USD=5

# --- URL wiring for the frontends (server-to-server + browser) ---
API_URL=http://api:4000

# --- Mail (Resend) ---
RESEND_API_KEY=
RESEND_FROM=

# --- API keys ---
API_KEY_PEPPER=CHANGE_ME_random

# --- Payments (Cryptomus) ---
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=
CRYPTOMUS_IP_ALLOWLIST=

# --- Bootstrap superadmin (seed) ---
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
